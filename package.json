{
  "name": "sunchon-eco-agenda",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name sunchon-eco-agenda",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply sunchon-eco-production --local",
    "db:seed": "wrangler d1 execute sunchon-eco-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "dev:sandbox": "wrangler pages dev dist --d1=sunchon-eco-production --local --ip 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "hono": "^4.12.11"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
